# Jenkins / droplet coordinates for Zyrowaste production
# Set these as Jenkins Global Properties or job env (Manage Jenkins → System)

PROD_HOST=143.244.128.22
DEPLOY_PATH=/opt/zyrowaste
DOMAIN=zyrowaste.com

# Registry (change IMAGE_NAMESPACE to your GHCR org/user if different)
DOCKER_REGISTRY=ghcr.io
IMAGE_NAMESPACE=zyrowaste

# After DNS is pointed:
#   A  @    → 143.244.128.22
#   A  www  → 143.244.128.22
