# Production secrets — copy to /opt/zyrowaste/.env.production on the server
# NEVER commit the real .env.production file

GROQ_API_KEY=gsk_your_key_here
JWT_SECRET=replace-with-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_EXPIRE_MINUTES=60
AUTH_DEBUG_RETURN_RESET_TOKEN=false

POSTGRES_USER=zyrowaste
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=zyrowaste
DATABASE_URL=postgresql+psycopg2://zyrowaste:replace-with-strong-password@postgres:5432/zyrowaste

CORS_ORIGINS=https://zyrowaste.com,https://www.zyrowaste.com

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=llama-3.3-70b-versatile
CHROMA_PERSIST_DIR=/data/chroma

# Image coordinates (must match Jenkins REGISTRY / IMAGE_NAMESPACE)
FRONTEND_IMAGE=ghcr.io/zyrowaste/frontend
BACKEND_IMAGE=ghcr.io/zyrowaste/backend
IMAGE_TAG=latest

# Optional: registry login on the droplet (prefer docker login once as root)
# DOCKER_REGISTRY=ghcr.io
# DOCKER_USER=your-github-user
# DOCKER_PASSWORD=ghp_xxxxxxxxxxxx
